{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Remc0000/Fabric-Engineering-OS/blob/main/metadata/guidance-freshness.schema.json",
  "title": "Fabric Engineering OS guidance freshness manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "contentType",
          "status",
          "owner",
          "lastValidated",
          "reviewBy",
          "sources"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(capabilities|patterns|golden-paths|reference-architectures)/[A-Za-z0-9][A-Za-z0-9._-]*\\.md$"
          },
          "contentType": {
            "enum": [
              "capability",
              "pattern",
              "golden-path",
              "reference-architecture"
            ]
          },
          "status": {
            "enum": [
              "preview",
              "stable",
              "deprecated"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "lastValidated": {
            "type": "string",
            "format": "date"
          },
          "reviewBy": {
            "type": "string",
            "format": "date"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^https://learn\\.microsoft\\.com/"
            }
          }
        }
      }
    }
  }
}
