{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Remc0000/Fabric-Engineering-OS/blob/main/metadata/os-catalog.schema.json",
  "title": "Fabric Engineering OS discovery catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "title",
          "status",
          "path",
          "dependencies",
          "related"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(capability|pattern|golden-path|reference-architecture|agent-bundle):[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": {
            "enum": [
              "capability",
              "pattern",
              "golden-path",
              "reference-architecture",
              "agent-bundle"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "preview",
              "stable",
              "deprecated"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^(capabilities|patterns|golden-paths|reference-architectures)/[a-z0-9][a-z0-9-]*\\.md$|^agent-bundles/[a-z0-9][a-z0-9-]*/charter\\.md$"
          },
          "dependencies": {
            "$ref": "#/$defs/idArray"
          },
          "related": {
            "$ref": "#/$defs/idArray"
          },
          "freshnessRef": {
            "type": "string",
            "pattern": "^(capabilities|patterns|golden-paths|reference-architectures)/[a-z0-9][a-z0-9-]*\\.md$"
          },
          "extensions": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9-]+)+$"
            },
            "additionalProperties": true
          }
        }
      }
    }
  },
  "$defs": {
    "idArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(capability|pattern|golden-path|reference-architecture|agent-bundle):[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  }
}
